---
import logo from '../logoUTM.png';

const apiUrl = import.meta.env.PUBLIC_API_URL || 'http://127.0.0.1:8000';
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="Clasificación de requisitos de software en español mediante BETO + BiLSTM." />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>Elbeto | Clasificación de requisitos</title>
  </head>
  <body>
    <main class="shell" data-api-url={apiUrl}>
      <header class="topbar">
        <a class="brand" href="/" aria-label="Inicio de Elbeto">
          <img class="institution-logo" src={logo.src} alt="Universidad Técnica de Manabí" />
          <span class="brand-name">ELBETO <small>CLASIFICACIÓN DE REQUISITOS</small></span>
        </a>
        <div class="service-status"><span class="pulse" id="health-dot"></span><span id="health-text">Verificando servicio</span></div>
      </header>

      <section class="hero">
        <div>
          <p class="eyebrow">RF / RNF / PROCESAMIENTO EN ESPAÑOL</p>
          <h1>Clasificación inteligente<br /><em>de requisitos.</em></h1>
          <p class="intro">Analiza especificaciones de software y determina si describen una funcionalidad del sistema o una condición de calidad. El análisis utiliza un modelo BETO con una capa BiLSTM.</p>
        </div>
        <aside class="model-card">
          <span class="card-label">MODELO ACTIVO</span>
          <strong>BETO + BiLSTM</strong>
          <span>Representación contextual en español</span>
          <span>Clasificación binaria · Inferencia local</span>
        </aside>
      </section>

      <section class="panel input-panel">
        <div class="panel-heading"><div><span class="index">01</span><h2>Analizar requisito</h2></div><span class="method">CLASIFICACIÓN INDIVIDUAL</span></div>
        <label class="field-label" for="requirement-text">Entrada en español</label>
        <textarea id="requirement-text" rows="6" maxlength="10000" placeholder="El sistema debe permitir registrar nuevos usuarios."></textarea>
        <div class="composer-footer"><span id="char-count">0 / 10.000</span><button class="primary" id="predict-button" type="button">Clasificar <span>→</span></button></div>
        <div class="error" id="predict-error" role="alert"></div>
      </section>

      <section class="results-section">
        <div class="section-heading"><div><span class="index">02</span><h2>Resultado</h2></div><span class="live-tag">BETO + BILSTM</span></div>
        <div class="empty-state" id="result-empty"><span class="target">◎</span><p>Esperando requisito</p><small>Escribe una especificación para obtener su clasificación.</small></div>
        <article class="result-card hidden" id="result-card">
          <div class="result-top"><div><span class="result-label" id="result-label">RF</span><p id="result-kind">Requisito funcional</p></div><span class="model-chip">BETO + BiLSTM</span></div>
          <div class="confidence-row"><span>Confianza del modelo</span><strong id="result-confidence">0%</strong></div>
          <div class="confidence-track"><span id="result-bar"></span></div>
          <div class="result-meta"><div><span>INTERPRETACIÓN</span><strong id="result-description">El sistema define una acción o capacidad.</strong></div><div><span>LATENCIA</span><strong id="result-latency">0 ms</strong></div></div>
        </article>
      </section>

      <section class="panel batch-panel">
        <div class="panel-heading"><div><span class="index">03</span><h2>Evaluación por lote</h2></div><span class="method">HASTA 256 ENTRADAS</span></div>
        <p class="panel-note">Introduce un requisito por línea para procesar varias especificaciones en una sola solicitud.</p>
        <textarea id="batch-text" rows="5" placeholder="El sistema debe permitir registrar usuarios.&#10;La disponibilidad mensual debe superar el 99,9 %." ></textarea>
        <div class="composer-footer"><span id="batch-count">0 requisitos</span><button class="primary" id="batch-button" type="button">Procesar lote <span>→</span></button></div>
        <div class="error" id="batch-error" role="alert"></div>
        <div class="table-wrap hidden" id="batch-results"><table><thead><tr><th>#</th><th>Requisito</th><th>Clasificación</th><th>Confianza</th></tr></thead><tbody id="batch-body"></tbody></table></div>
      </section>

      <footer><span>RF = Funcional · RNF = No funcional</span><span>Procesamiento local · No se guardan textos</span></footer>
    </main>
  </body>
</html>

<style>
  @import url('https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=Space+Grotesk:wght@400;500;600;700&display=swap');
  :global(*) { box-sizing: border-box; }
  :global(:root) { --green: rgb(19, 150, 72); --green-bright: #35c979; --teal-950: #0d2022; --teal-900: #102b2d; --line: #2c4848; --muted: #9db1ad; --white: #fff; }
  :global(body) { margin: 0; color: var(--white); background: var(--teal-950); font-family: 'Space Grotesk', sans-serif; }
  :global(body)::before { content: ''; position: fixed; inset: 0; pointer-events: none; opacity: .24; background-image: linear-gradient(rgba(255,255,255,.025) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,.025) 1px, transparent 1px); background-size: 42px 42px; }
  .shell { max-width: 1180px; margin: auto; padding: 28px 34px 22px; position: relative; }
  .topbar, .composer-footer, footer, .panel-heading, .section-heading, .result-top { display: flex; align-items: center; justify-content: space-between; gap: 16px; }
  .topbar { background: var(--white); border: 2px solid #dce8e3; border-radius: 999px; padding: 15px 24px; box-shadow: 0 14px 34px rgba(0,0,0,.16); }
  .brand { color: var(--teal-950); text-decoration: none; font-weight: 700; letter-spacing: .08em; display: flex; align-items: center; gap: 15px; min-width: 0; }
  .institution-logo { display: block; width: 226px; max-height: 87px; object-fit: contain; border-radius: 4px; }
  .brand-name { white-space: nowrap; }.brand small { display: block; color: #28544f; opacity: 1; letter-spacing: .18em; font: 500 10px 'DM Mono', monospace; margin-top: 3px; }
  .service-status, .method, .live-tag, .eyebrow, .card-label, .field-label, footer, .index, .model-chip { color: var(--muted); font: 11px 'DM Mono', monospace; letter-spacing: .08em; text-transform: uppercase; }
  .service-status { color: #52706d; }.pulse { display: inline-block; width: 8px; height: 8px; border-radius: 50%; background: var(--green-bright); box-shadow: 0 0 12px var(--green-bright); margin-right: 7px; }.pulse.off { background: #ff806d; box-shadow: 0 0 12px #ff806d; }
  .hero { display: grid; grid-template-columns: 1fr 300px; gap: 60px; padding: 78px 0 62px; }.eyebrow { color: var(--green-bright); margin: 0 0 18px; }h1 { font-size: clamp(42px, 6vw, 76px); line-height: .96; letter-spacing: -.065em; margin: 0; font-weight: 600; }h1 em { color: var(--green-bright); font-style: normal; }h2 { font-size: 17px; letter-spacing: -.02em; margin: 0; }.intro { max-width: 610px; color: #9da39f; line-height: 1.65; margin: 25px 0 0; font-size: 15px; }
  .model-card { align-self: end; border-left: 2px solid var(--green); padding: 15px 0 15px 18px; display: grid; gap: 9px; color: var(--muted); font-size: 12px; }.model-card strong { color: #f3f0e8; font-size: 19px; }
  .panel, .results-section { background: var(--teal-900); border: 1px solid var(--line); padding: 22px; }.panel-heading, .section-heading { margin-bottom: 22px; }.panel-heading > div, .section-heading > div { display: flex; align-items: center; gap: 12px; }.index { color: var(--green-bright); }.method { font-size: 10px; color: #5e6864; }.live-tag { color: var(--green-bright); font-size: 10px; }.field-label { display: block; margin-bottom: 9px; font-size: 10px; }
  textarea { width: 100%; display: block; padding: 14px; resize: vertical; line-height: 1.55; border: 1px solid #365353; background: #0a191b; color: var(--white); font: 14px 'DM Mono', monospace; outline: none; border-radius: 2px; }textarea:focus { border-color: var(--green-bright); box-shadow: 0 0 0 2px rgba(19,150,72,.18); }.composer-footer { margin-top: 13px; color: #69726e; font: 11px 'DM Mono', monospace; }.error { color: #ff806d; font: 12px 'DM Mono', monospace; margin-top: 12px; min-height: 16px; }
  button { border: 0; cursor: pointer; font: 600 12px 'DM Mono', monospace; letter-spacing: .04em; text-transform: uppercase; }button:disabled { cursor: wait; opacity: .55; }.primary { color: var(--white); background: var(--green); padding: 13px 17px; min-width: 145px; }.primary span { font-size: 17px; margin-left: 8px; }.spinner { display: inline-block; width: 11px; height: 11px; margin-right: 8px; border: 2px solid rgba(17,19,20,.35); border-top-color: #111314; border-radius: 50%; animation: spin .7s linear infinite; vertical-align: -1px; }@keyframes spin { to { transform: rotate(360deg); } }
  .results-section { margin-top: 18px; }.empty-state { min-height: 235px; display: grid; place-content: center; text-align: center; color: #6c7571; }.target { display: block; color: #3e4745; font-size: 55px; line-height: 1; }.empty-state p { margin: 13px 0 4px; color: #9da39f; font-size: 15px; }.empty-state small { font: 11px 'DM Mono', monospace; }.hidden { display: none !important; }
  .result-card { background: #111314; border: 1px solid var(--green); box-shadow: inset 0 3px var(--green); padding: 24px; }.result-label { color: var(--green-bright); font: 700 36px 'DM Mono', monospace; letter-spacing: -.08em; }.result-top p { margin: 7px 0 0; color: #9da39f; }.model-chip { color: var(--green-bright); }.confidence-row { display: flex; align-items: baseline; justify-content: space-between; margin: 30px 0 9px; color: #89918d; font: 12px 'DM Mono', monospace; }.confidence-row strong { color: var(--white); font-size: 17px; }.confidence-track { height: 7px; background: #303736; }.confidence-track span { display: block; height: 100%; background: var(--green-bright); transition: width .4s ease; }.result-meta { display: flex; gap: 50px; margin-top: 24px; }.result-meta div { display: grid; gap: 8px; }.result-meta span { color: #89918d; font: 11px 'DM Mono', monospace; }.result-meta strong { font: 13px 'DM Mono', monospace; font-weight: 500; }
  .batch-panel { margin-top: 18px; }.panel-note { color: #89918d; font-size: 13px; margin: -10px 0 16px; }.table-wrap { overflow-x: auto; margin-top: 24px; border-top: 1px solid #303435; }table { width: 100%; border-collapse: collapse; font-size: 13px; }th, td { padding: 13px 10px; text-align: center; vertical-align: middle; border-bottom: 1px solid #303435; }th { color: #69726e; font: 10px 'DM Mono', monospace; text-transform: uppercase; }th:nth-child(3), th:nth-child(4), td:nth-child(3), td:nth-child(4), .batch-result-cell { text-align: center !important; }td:first-child { color: #69726e; font-family: 'DM Mono', monospace; }td:nth-child(2) { max-width: 560px; }.batch-label { display: block; text-align: center; font: 700 14px 'DM Mono', monospace; }.batch-confidence { display: block; width: 100%; text-align: center; font-family: 'DM Mono', monospace; }.rf { color: #78c8ff; }.rnf { color: #ffb454; }
  :global(#batch-body td) { padding: 13px 10px; text-align: center !important; vertical-align: middle; border-bottom: 1px solid #303435; }
  :global(#batch-body td:nth-child(3)), :global(#batch-body td:nth-child(4)), :global(.batch-result-cell) { text-align: center !important; }
  :global(.batch-label) { display: block; text-align: center; font: 700 14px 'DM Mono', monospace; }
  :global(.batch-confidence) { display: block; width: 100%; text-align: center; font-family: 'DM Mono', monospace; }
  :global(.rf) { color: #78c8ff; } :global(.rnf) { color: #ffb454; }
  footer { margin-top: 22px; padding-top: 18px; border-top: 1px solid #303435; font-size: 10px; }
  @media (max-width: 760px) { .shell { padding: 16px; }.topbar { align-items: center; }.brand { gap: 9px; }.institution-logo { width: 130px; max-height: 55px; }.brand-name { display: block; font-size: 12px; letter-spacing: .06em; }.brand small { font-size: 7px; letter-spacing: .12em; }.service-status { display: none; }.hero { grid-template-columns: 1fr; gap: 30px; padding: 48px 0 38px; }.model-card { align-self: start; }.result-top { align-items: flex-start; flex-direction: column; }.result-meta { gap: 24px; flex-wrap: wrap; }.method { display: none; }footer { align-items: flex-start; flex-direction: column; } }
</style>

<script>
  const baseUrl = (document.querySelector('.shell') as HTMLElement).dataset.apiUrl!.replace(/\/$/, '');
  const requirementText = document.querySelector('#requirement-text') as HTMLTextAreaElement;
  const batchText = document.querySelector('#batch-text') as HTMLTextAreaElement;
  const predictButton = document.querySelector('#predict-button') as HTMLButtonElement;
  const batchButton = document.querySelector('#batch-button') as HTMLButtonElement;
  const predictError = document.querySelector('#predict-error') as HTMLElement;
  const batchError = document.querySelector('#batch-error') as HTMLElement;
  const formatPercent = (value: number): string => `${(value * 100).toFixed(1)}%`;
  const escapeHtml = (value: string): string => value.replaceAll('&', '&amp;').replaceAll('<', '&lt;').replaceAll('>', '&gt;');
  const setBusy = (button: HTMLButtonElement, busy: boolean, label: string): void => { button.disabled = busy; button.dataset.original = button.dataset.original || button.innerHTML; button.innerHTML = busy ? `<span class="spinner"></span>${label}` : button.dataset.original!; };
  const apiFetch = (path: string, options: RequestInit = {}): Promise<Response> => fetch(`${baseUrl}${path}`, { ...options, headers: { 'Content-Type': 'application/json', 'ngrok-skip-browser-warning': 'true', ...(options.headers || {}) } });

  async function checkHealth(): Promise<void> {
    try { const response = await apiFetch('/health'); if (!response.ok) throw new Error(); (document.querySelector('#health-text') as HTMLElement).textContent = 'SERVICIO LISTO'; }
    catch { document.querySelector('#health-dot')?.classList.add('off'); (document.querySelector('#health-text') as HTMLElement).textContent = 'SERVICIO NO DISPONIBLE'; }
  }

  function showResult(data: any): void {
    const label = data.label; const confidence = Number(data.confidence); const isFunctional = label === 'RF';
    (document.querySelector('#result-label') as HTMLElement).textContent = label;
    (document.querySelector('#result-label') as HTMLElement).className = `result-label ${isFunctional ? 'rf' : 'rnf'}`;
    (document.querySelector('#result-kind') as HTMLElement).textContent = isFunctional ? 'Requisito funcional' : 'Requisito no funcional';
    (document.querySelector('#result-description') as HTMLElement).textContent = isFunctional ? 'El sistema define una acción o capacidad.' : 'El sistema define una condición de calidad o restricción.';
    (document.querySelector('#result-confidence') as HTMLElement).textContent = formatPercent(confidence);
    (document.querySelector('#result-bar') as HTMLElement).style.width = `${confidence * 100}%`;
    (document.querySelector('#result-latency') as HTMLElement).textContent = `${data.execution_time_ms} ms`;
    document.querySelector('#result-empty')?.classList.add('hidden'); document.querySelector('#result-card')?.classList.remove('hidden');
  }

  async function predict(): Promise<void> {
    predictError.textContent = ''; if (!requirementText.value.trim()) { predictError.textContent = 'Escribe un requisito primero.'; return; } setBusy(predictButton, true, 'Analizando...');
    try { const response = await apiFetch('/api/predict', { method: 'POST', body: JSON.stringify({ text: requirementText.value }) }); const data = await response.json(); if (!response.ok) throw new Error(data.detail || 'No fue posible clasificar el requisito.'); showResult(data); }
    catch (error) { predictError.textContent = error instanceof Error ? error.message : 'No fue posible clasificar el requisito.'; } finally { setBusy(predictButton, false, ''); }
  }

  async function predictBatch(): Promise<void> {
    batchError.textContent = ''; const texts = batchText.value.split('\n').map((text) => text.trim()).filter(Boolean); if (!texts.length) { batchError.textContent = 'Añade un requisito por línea.'; return; } setBusy(batchButton, true, 'Procesando...');
    try { const response = await apiFetch('/api/predict/batch', { method: 'POST', body: JSON.stringify({ texts }) }); const data = await response.json(); if (!response.ok) throw new Error(data.detail || 'No fue posible procesar el lote.'); (document.querySelector('#batch-results') as HTMLElement).classList.remove('hidden'); (document.querySelector('#batch-body') as HTMLElement).innerHTML = data.predictions.map((prediction: any, index: number) => `<tr><td>${index + 1}</td><td>${escapeHtml(texts[index])}</td><td class="batch-result-cell"><span class="batch-label ${prediction.label.toLowerCase()}">${prediction.label}</span></td><td class="batch-result-cell"><span class="batch-confidence">${formatPercent(prediction.confidence)}</span></td></tr>`).join(''); }
    catch (error) { batchError.textContent = error instanceof Error ? error.message : 'No fue posible procesar el lote.'; } finally { setBusy(batchButton, false, ''); }
  }

  requirementText.addEventListener('input', () => { (document.querySelector('#char-count') as HTMLElement).textContent = `${requirementText.value.length.toLocaleString()} / 10,000`; });
  batchText.addEventListener('input', () => { const count = batchText.value.split('\n').filter((line) => line.trim()).length; (document.querySelector('#batch-count') as HTMLElement).textContent = `${count} requisito${count === 1 ? '' : 's'}`; });
  predictButton.addEventListener('click', predict); batchButton.addEventListener('click', predictBatch); checkHealth();
</script>
