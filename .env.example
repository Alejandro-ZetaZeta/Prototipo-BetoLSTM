# FastAPI model directory inside the container.
MODEL_DIR=/models/beto_lstm_rf_rnf

# Comma-separated Astro origins allowed to call the API.
ALLOWED_ORIGINS=http://localhost:4321,http://127.0.0.1:4321

# ngrok credentials and assigned development domain.
# Get both from the ngrok dashboard. Never commit the real token.
NGROK_AUTHTOKEN=
NGROK_DOMAIN=https://your-assigned-domain.ngrok-free.app
